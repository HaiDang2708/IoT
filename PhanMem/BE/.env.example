# MQTT Configuration
MQTT_BROKER_URL=ws://broker.hivemq.com:8000/mqtt
MQTT_CLIENT_ID=dang_iot_backend_bridge

# Topics to Subscribe
TOPIC_TEMP=dang_iot_b23dcat036/temp
TOPIC_HUM=dang_iot_b23dcat036/hum
TOPIC_LUX=dang_iot_b23dcat036/lux

TOPIC_LED1_STATE=dang_iot_b23dcat036/led/state
TOPIC_LED2_STATE=dang_iot_b23dcat036/led2/state
TOPIC_LED3_STATE=dang_iot_b23dcat036/led3/state

# MQTT Authentication (Optional)
MQTT_USERNAME=
MQTT_PASSWORD=

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=dang_iot

# Backend API Port
PORT=5000
